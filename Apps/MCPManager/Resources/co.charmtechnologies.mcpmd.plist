<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>co.charmtechnologies.mcpmd</string>
	<!-- Relative to the app bundle, so the agent always runs the daemon that shipped with the
	     app the user actually has: an upgrade swaps the bundle and the next launch is the new
	     binary, with no plist rewrite. -->
	<key>BundleProgram</key>
	<string>Contents/MacOS/mcpmd</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart on a crash, but not on a clean exit: the daemon exits 0 when another instance
	     already owns the control socket, and an unconditional KeepAlive would respawn it into
	     the same conflict forever. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<!-- Lets Login Items show this agent under "MCP Manager" rather than as a bare label. -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>co.charmtechnologies.mcpmanager</string>
	</array>
</dict>
</plist>
